{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Hangfire": {
    "Enabled": false
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Jwt": {
    "Issuer": "CulinaryBlog.API",
    "Audience": "CulinaryBlog.Web",
    "AccessTokenExpirationMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000"
    ]
  }
}
